---
// Compatibility: /en/* redi  rects to the same path without prefix (English by default)
export async function getStaticPaths() {
  return ['home', 'mission', 'services', 'contact'].map((section) => ({
    params: { section },
  }));
}

const { section } = Astro.params;
const targetPath = section === 'home' ? '/home' : `/${section}`;
return Astro.redirect(targetPath, 301);
---
